{
  "name": "@crdsyntax/nestjs-socket-docs",
  "version": "1.0.0",
  "description": "Swagger-like documentation for NestJS WebSockets",
  "author": "crdsyntax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crdsyntax/nestjs-socket-docs.git",
