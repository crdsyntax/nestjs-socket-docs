{
  "name": "@crdsyntax/nestjs-socket-docs",
  "version": "2.4.0",
  "description": "Swagger-like documentation for NestJS WebSockets",
  "author": "crdsyntax",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ui-dist",
    "README.md"
  ],
