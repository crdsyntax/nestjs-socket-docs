    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^22.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "vitest": "^0.34.0"
  }
