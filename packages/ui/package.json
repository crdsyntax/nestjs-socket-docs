{
  "name": "@crdsyntax/nestjs-socket-docs-ui",
  "version": "2.4.0",
  "description": "UI for nestjs-socket-docs",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
