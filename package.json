{
  "name": "nestjs-socket-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for nestjs-socket-docs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "publish:all": "npm publish --workspaces --access public"
  },
  "devDependencies": {
    "typescript": "5.3.3"
  }
}
